<% if flash[:alert] %>
    <ul>
        <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
        <% end %>
    </ul>
<% end %>

<%= form_with model: @post do |form|%>
<%= form.hidden_field :user_id, value: current_user.id %>
<%= form.label :title %>
<%= form.text_field :title %>
<%= form.label :body %>
<%= form.text_field :body %>
<%= form.submit "Create Post" %>
<%end%>
<%= link_to "Back", :root %>
